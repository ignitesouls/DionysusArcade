<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Dionysus.Core\Dionysus.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
	<AssemblyName>Dionysus Arcade v0.3</AssemblyName>
	<RootNamespace>Dionysus.App</RootNamespace>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

	<ItemGroup>
		<None Update="oo2core_6_win64.dll" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
		<None Update="Resources\**\*" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
	</ItemGroup>

</Project>
