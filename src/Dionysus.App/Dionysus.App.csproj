<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Dionysus.Core\Dionysus.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
	<AssemblyName>Dionysus Arcade v0.3</AssemblyName>
	<RootNamespace>Dionysus.App</RootNamespace>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
	<ApplicationIcon>Assets\dionysus.ico</ApplicationIcon>
  </PropertyGroup>

	<ItemGroup>
		<None Update="oo2core_6_win64.dll" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
		<None Update="Resources\**\*" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="WPF-UI" Version="4.1.0" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="Assets\**" />
		<Resource Include="Assets\**" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Resources\Modes\" />
	</ItemGroup>

	<ItemGroup>
		<!-- The license and notices travel with the app, without cluttering its main folder -->
		<None Include="..\..\LICENSE" Link="Resources\Licenses\LICENSE.txt"
			  CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
		<None Include="..\..\THIRD_PARTY_NOTICES.md" Link="Resources\Licenses\THIRD_PARTY_NOTICES.md"
			  CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
	</ItemGroup>

</Project>
