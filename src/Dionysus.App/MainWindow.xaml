<ui:FluentWindow x:Class="Dionysus.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Dionysus Arcade v0.3" Height="720" Width="960" MinHeight="520" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        Icon="/Assets/dionysus.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Dionysus Arcade v0.3">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="/Assets/dionysus_256.png"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <TabControl Grid.Row="1" Margin="12,4,12,12">

            <!-- Quick Play: modes arrive in Step 19 -->
            <TabItem Header="Quick Play">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="/Assets/dionysus_256.png" Width="160" Height="160"/>
                    <TextBlock Text="Dionysus Arcade" FontSize="28" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,12,0,4"/>
                    <TextBlock Text="Quick Play modes are coming soon." HorizontalAlignment="Center" Opacity="0.7"/>
                </StackPanel>
            </TabItem>

            <!-- Custom: the current build screen, extended in Step 20 -->
            <TabItem Header="Custom">
                <DockPanel Margin="16">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Seed:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ui:TextBox x:Name="SeedBox" Width="200" PlaceholderText="Empty for random"/>
                        <ui:Button x:Name="RandomizeButton" Content="Randomize" Appearance="Primary"
                                   Margin="12,0,0,0" Click="RandomizeButton_Click"/>
                        <ui:Button x:Name="LaunchButton" Content="Launch Elden Ring"
                                   Margin="8,0,0,0" Click="LaunchButton_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="StatusText" DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ReportText" DockPanel.Dock="Top" Margin="0,0,0,12" TextWrapping="Wrap"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="OptionsPanel"/>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- Settings -->
            <TabItem Header="Settings">
                <StackPanel Margin="16">
                    <TextBlock Text="Theme" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ComboBox x:Name="ThemeBox" Width="200" HorizontalAlignment="Left">
                        <ComboBoxItem Content="System"/>
                        <ComboBoxItem Content="Light"/>
                        <ComboBoxItem Content="Dark"/>
                    </ComboBox>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</ui:FluentWindow>