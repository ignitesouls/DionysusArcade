<ui:FluentWindow x:Class="Dionysus.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Dionysus Arcade v0.3" Height="720" Width="960" MinHeight="520" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        Icon="/Assets/dionysus.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Dionysus Arcade v0.3">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="/Assets/dionysus_256.png"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <TabControl x:Name="Tabs" Grid.Row="1" Margin="12,4,12,12">

            <!-- Modes: built-in modes and saved profiles, one click away -->
            <TabItem Header="Modes">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0" Margin="0,0,16,0">
                        <Image DockPanel.Dock="Top" Source="/Assets/dionysus_256.png" Width="96" Height="96" Margin="0,0,0,12"/>
                        <ListBox x:Name="ModeList" DisplayMemberPath="DisplayName"/>
                    </DockPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="ModeNameText" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock x:Name="ModeDescriptionText" TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,16"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Seed:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ui:TextBox x:Name="ModeSeedBox" Width="200" PlaceholderText="Empty for random"/>
                            <ui:Button x:Name="ModeRandomizeButton" Content="Assemble" Appearance="Primary"
                                       Margin="12,0,0,0" Click="ModeRandomizeButton_Click"/>
                            <ui:Button x:Name="ModeLaunchButton" Content="Launch Elden Ring"
                                       Margin="8,0,0,0" Click="LaunchButton_Click"/>
                        </StackPanel>

                        <TextBlock x:Name="ModeStatusText" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock x:Name="ModeReportText" TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <ui:Button Content="Customize this mode" Click="CustomizeButton_Click"/>
                            <!-- Only shown when a profile is selected -->
                            <ui:Button x:Name="DeleteModeButton" Content="Delete this mode" Margin="8,0,0,0"
                                       Visibility="Collapsed" Click="DeleteProfileButton_Click"/>
                        </StackPanel>

                        <!-- Only shown when a profile is selected -->
                        <StackPanel x:Name="ProfileActions" Orientation="Horizontal" Visibility="Collapsed">
                            <ui:TextBox x:Name="RenameBox" Width="200" PlaceholderText="New name"/>
                            <ui:Button Content="Rename" Margin="8,0,0,0" Click="RenameProfileButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Custom: change anything, build directly, or save as a profile -->
            <TabItem Header="Custom">
                <DockPanel Margin="16">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Start from:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="PresetBox" Width="260" DisplayMemberPath="DisplayName"/>
                        <ui:Button Content="Load" Margin="8,0,0,0" Click="LoadPresetButton_Click"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Save as profile:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ui:TextBox x:Name="ProfileNameBox" Width="260" PlaceholderText="Profile name"/>
                        <ui:Button Content="Save" Margin="8,0,0,0" Click="SaveProfileButton_Click"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Seed:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ui:TextBox x:Name="SeedBox" Width="200" PlaceholderText="Empty for random"/>
                        <ui:Button x:Name="RandomizeButton" Content="Assemble" Appearance="Primary"
                                   Margin="12,0,0,0" Click="RandomizeButton_Click"/>
                        <ui:Button x:Name="LaunchButton" Content="Launch Elden Ring"
                                   Margin="8,0,0,0" Click="LaunchButton_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="StatusText" DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ReportText" DockPanel.Dock="Top" Margin="0,0,0,12" TextWrapping="Wrap"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="OptionsPanel"/>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

        </TabControl>

        <!-- Settings: a large gear at the right end of the tab headers -->
        <ui:Button x:Name="SettingsButton" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Top"
                   Margin="0,2,20,0" Padding="4" Appearance="Transparent"
                   Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                   ToolTip="Settings" Click="SettingsButton_Click">
            <ui:Button.Icon>
                <ui:SymbolIcon Symbol="Settings24" FontSize="30"/>
            </ui:Button.Icon>
        </ui:Button>
    </Grid>
</ui:FluentWindow>